# Prefer absolute path locally if Prisma CLI and Next disagree on relative resolution.
# Next.js (cwd=repo root): file:./prisma/dev.db
# Prisma CLI with schema in prisma/: often resolves file:./dev.db → prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="meu-plano-dev-secret-change-in-production"
AUTH_URL="http://localhost:43123"
NEXTAUTH_URL="http://localhost:43123"
AUTH_TRUST_HOST=true
