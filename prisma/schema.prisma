// Meu Plano — schema pronto para SQLite (MVP) e Postgres/Supabase (trocar provider + url)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("user") // user | admin
  city          String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plans                 UserPlan[]
  favorites             Favorite[]
  confirmations         Confirmation[]
  verificationRequests  VerificationRequest[]
  searches              SearchEvent[]
  whatsappClicks        WhatsAppClick[]
}

model HealthPlan {
  id        String   @id @default(cuid())
  operator  String
  name      String
  category  String?
  createdAt DateTime @default(now())

  userPlans     UserPlan[]
  providerPlans ProviderPlan[]
  confirmations Confirmation[]
  verificationRequests VerificationRequest[]

  @@unique([operator, name])
}

model UserPlan {
  id           String   @id @default(cuid())
  userId       String
  healthPlanId String
  planNumber   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model Specialty {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  category    String   // medico | exame | laboratorio | hospital | pronto_atendimento | terapia
  keywords    String   @default("") // CSV de sinônimos para busca NLP MVP
  createdAt   DateTime @default(now())

  providers ProviderSpecialty[]
}

model Provider {
  id          String   @id @default(cuid())
  name        String
  type        String   // medico | clinica | laboratorio | hospital | pronto_atendimento | terapia
  description String?
  photoUrl    String?
  phone       String?
  whatsapp    String?
  email       String?
  address     String
  neighborhood String
  city        String
  state       String   @default("SP")
  cep         String?
  latitude    Float
  longitude   Float
  rating      Float    @default(4.5)
  reviewCount Int      @default(0)
  hoursJson   String   @default("{}") // JSON de horários
  openToday   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specialties          ProviderSpecialty[]
  plans                ProviderPlan[]
  confirmations        Confirmation[]
  verificationRequests VerificationRequest[]
  favorites            Favorite[]
  whatsappClicks       WhatsAppClick[]
}

model ProviderSpecialty {
  providerId   String
  specialtyId  String

  provider  Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([providerId, specialtyId])
}

model ProviderPlan {
  id           String   @id @default(cuid())
  providerId   String
  healthPlanId String
  // confirmed | unconfirmed | not_accepted
  status       String   @default("unconfirmed")
  // clinic | user | operator
  source       String   @default("operator")
  lastVerifiedAt DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)

  @@unique([providerId, healthPlanId])
}

model Confirmation {
  id           String   @id @default(cuid())
  userId       String
  providerId   String
  healthPlanId String
  // yes | no | unknown
  answer       String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)

  @@index([providerId, healthPlanId, createdAt])
}

model VerificationRequest {
  id           String   @id @default(cuid())
  userId       String
  providerId   String
  healthPlanId String
  status       String   @default("pending") // pending | contacted | resolved
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  providerId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
}

// Métricas futuras (já estruturadas)
model SearchEvent {
  id          String   @id @default(cuid())
  userId      String?
  query       String
  specialty   String?
  city        String?
  planId      String?
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model WhatsAppClick {
  id         String   @id @default(cuid())
  userId     String?
  providerId String
  createdAt  DateTime @default(now())

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}
