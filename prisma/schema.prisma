// Meu Plano — schema pronto para SQLite (MVP) e Postgres/Supabase (trocar provider + url)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("user") // user | admin
  city          String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plans                 UserPlan[]
  favorites             Favorite[]
  confirmations         Confirmation[]
  experiences           ProviderExperience[]
  verificationRequests  VerificationRequest[]
  searches              SearchEvent[]
  whatsappClicks        WhatsAppClick[]
  commentReports        CommentReport[]
  profileClaims         ProfileClaim[]
}

model HealthPlan {
  id        String   @id @default(cuid())
  operator  String
  name      String
  category  String?
  ansCode   String?
  createdAt DateTime @default(now())

  userPlans     UserPlan[]
  providerPlans ProviderPlan[]
  confirmations Confirmation[]
  experiences   ProviderExperience[]
  verificationRequests VerificationRequest[]
  planHistory   ProviderPlanHistory[]
  planEvidence  ProviderPlanEvidence[]

  @@unique([operator, name])
}

model UserPlan {
  id           String   @id @default(cuid())
  userId       String
  healthPlanId String
  planNumber   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model Specialty {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  category    String   // medico | exame | laboratorio | hospital | pronto_atendimento | terapia
  keywords    String   @default("") // CSV de sinônimos para busca NLP MVP
  createdAt   DateTime @default(now())

  providers   ProviderSpecialty[]
  experiences ProviderExperience[]
}

model Provider {
  id           String   @id @default(cuid())
  name         String
  type         String   // medico | clinica | laboratorio | hospital | pronto_atendimento | terapia
  description  String?
  photoUrl     String?
  phone        String?
  whatsapp     String?
  email        String?
  documentCnpj String?
  documentCnes String?
  address      String
  neighborhood String
  city         String
  state        String   @default("SP")
  cep          String?
  latitude     Float
  longitude    Float
  rating       Float    @default(4.5)
  reviewCount  Int      @default(0)
  hoursJson    String   @default("{}") // JSON de horários
  openToday    Boolean  @default(true)
  claimed      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  specialties          ProviderSpecialty[]
  plans                ProviderPlan[]
  planHistory          ProviderPlanHistory[]
  planEvidence         ProviderPlanEvidence[]
  confirmations        Confirmation[]
  experiences          ProviderExperience[]
  verificationRequests VerificationRequest[]
  favorites            Favorite[]
  whatsappClicks       WhatsAppClick[]
  profileClaims        ProfileClaim[]
  dedupeAsA            ProviderDedupeReview[] @relation("DedupeA")
  dedupeAsB            ProviderDedupeReview[] @relation("DedupeB")
}

model ProviderSpecialty {
  providerId   String
  specialtyId  String

  provider  Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([providerId, specialtyId])
}

/// Proveniência atual do vínculo prestador ↔ plano (provider_plan_status)
model ProviderPlan {
  id             String   @id @default(cuid())
  providerId     String
  healthPlanId   String
  // confirmed | listed | reported_not_accepting | not_found | conflicting | stale
  // possibly_removed | removed_from_operator_network
  // legado: unconfirmed → listed, not_accepted → reported_not_accepting
  status         String   @default("listed")
  // operator | clinic | community | manual_admin (legado: user → community)
  sourceType     String   @default("operator")
  sourceUrl      String?
  sourceName     String?
  confidence     Float    @default(0.5)
  lastCheckedAt  DateTime?
  lastVerifiedAt DateTime?
  firstSeenAt    DateTime?
  lastSeenAt     DateTime?
  consecutiveMisses Int   @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // legado (mantido para compatibilidade de leitura)
  source String @default("operator")

  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)
  evidence   ProviderPlanEvidence[]

  @@unique([providerId, healthPlanId])
  @@index([status, lastCheckedAt])
}

/// Histórico imutável de mudanças de status
model ProviderPlanHistory {
  id             String   @id @default(cuid())
  providerId     String
  healthPlanId   String
  previousStatus String?
  newStatus      String
  sourceType     String
  sourceUrl      String?
  observedAt     DateTime @default(now())
  note           String?

  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)

  @@index([providerId, healthPlanId, observedAt])
}

/// Confirmação estruturada da comunidade (SIM/NÃO + contexto)
model ProviderExperience {
  id              String   @id @default(cuid())
  userId          String
  providerId      String
  healthPlanId    String
  specialtyId     String?
  accepted        Boolean
  experienceDate  DateTime?
  comment         String?
  createdAt       DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan  @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)
  specialty  Specialty?  @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  @@index([providerId, createdAt])
  @@index([healthPlanId, createdAt])
}

/// Confirmação legada (sim/não/unknown) — mantida
model Confirmation {
  id           String   @id @default(cuid())
  userId       String
  providerId   String
  healthPlanId String
  // yes | no | unknown
  answer       String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)

  @@index([providerId, healthPlanId, createdAt])
}

model VerificationRequest {
  id           String   @id @default(cuid())
  userId       String
  providerId   String
  healthPlanId String
  status       String   @default("pending") // pending | contacted | resolved
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  providerId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
}

model SearchEvent {
  id          String   @id @default(cuid())
  userId      String?
  query       String
  specialty   String?
  city        String?
  planId      String?
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model WhatsAppClick {
  id         String   @id @default(cuid())
  userId     String?
  providerId String
  createdAt  DateTime @default(now())

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model CommentReport {
  id         String   @id @default(cuid())
  userId     String
  targetType String   // experience | confirmation
  targetId   String
  reason     String   // spam | ofensa | info_pessoal | info_medica | falsa | outro
  details    String?
  status     String   @default("pending") // pending | reviewed | dismissed
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model ProfileClaim {
  id         String   @id @default(cuid())
  userId     String
  providerId String
  message    String?
  status     String   @default("pending") // pending | approved | rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model CrawlerRun {
  id           String   @id @default(cuid())
  operator     String
  adapter      String
  // queued | running | completed | partial | failed | success (legado)
  status       String   @default("running")
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  rawCount     Int      @default(0)
  upserted     Int      @default(0)
  recordsFound Int      @default(0)
  recordsCreated Int    @default(0)
  recordsUpdated Int    @default(0)
  duplicatesDetected Int @default(0)
  errorsCount  Int      @default(0)
  durationMs   Int?
  searchParametersJson String @default("{}")
  errorSummary String?
  isMock       Boolean  @default(false)
  errorsJson   String   @default("[]")
  note         String?

  rawResults CrawlerRawResult[]
  jobs       CrawlerJob[]
  evidence   ProviderPlanEvidence[]
}

model CrawlerRawResult {
  id               String   @id @default(cuid())
  runId            String
  operator         String
  planName         String
  planAnsCode      String?
  providerName     String
  providerDocument String?
  specialty        String?
  service          String?
  address          String?
  city             String?
  state            String?
  postalCode       String?
  phone            String?
  latitude         Float?
  longitude        Float?
  sourceUrl        String?
  collectedAt      DateTime @default(now())
  processed        Boolean  @default(false)
  payloadJson      String   @default("{}")
  requestPayloadJson String @default("{}")
  rawPayloadJson   String   @default("{}")
  httpStatus       Int?
  contentHash      String?
  unitName         String?
  neighborhood     String?
  complement       String?
  addressNumber    String?
  operatorProviderId String?

  run CrawlerRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence ProviderPlanEvidence[]

  @@index([runId, processed])
  @@index([contentHash])
}

/// Fila de jobs do worker (fora do request path do Next.js)
model CrawlerJob {
  id          String   @id @default(cuid())
  adapter     String
  // queued | running | completed | failed | cancelled
  status      String   @default("queued")
  paramsJson  String   @default("{}")
  runId       String?
  error       String?
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  run CrawlerRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// Evidências coexistentes (operadora / clínica / comunidade / admin) — uma não apaga a outra
model ProviderPlanEvidence {
  id           String   @id @default(cuid())
  providerId   String
  healthPlanId String
  providerPlanId String?
  // operator | clinic | community | admin
  sourceType   String
  sourceUrl    String?
  sourceName   String?
  collectedAt  DateTime @default(now())
  contentHash  String?
  note         String?
  crawlerRunId String?
  rawResultId  String?
  createdAt    DateTime @default(now())

  provider     Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  healthPlan   HealthPlan  @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)
  providerPlan ProviderPlan? @relation(fields: [providerPlanId], references: [id], onDelete: SetNull)
  crawlerRun   CrawlerRun? @relation(fields: [crawlerRunId], references: [id], onDelete: SetNull)
  rawResult    CrawlerRawResult? @relation(fields: [rawResultId], references: [id], onDelete: SetNull)

  @@index([providerId, healthPlanId, collectedAt])
  @@index([sourceType, collectedAt])
}

/// Casos duvidosos de deduplicação para revisão admin
model ProviderDedupeReview {
  id          String   @id @default(cuid())
  providerAId String
  providerBId String
  confidence  Float
  reason      String
  // pending | merged | kept_separate
  status      String   @default("pending")
  crawlerRunId String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  providerA Provider @relation("DedupeA", fields: [providerAId], references: [id], onDelete: Cascade)
  providerB Provider @relation("DedupeB", fields: [providerBId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@unique([providerAId, providerBId])
}
